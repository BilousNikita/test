# ════════════════════════════════════════════════════════════════════════════
#  Store configuration. Copy to .env and edit:   cp .env.example .env
#  Never commit .env – it contains secrets.
# ════════════════════════════════════════════════════════════════════════════

# ── Site ────────────────────────────────────────────────────────────────────
# Public base URL. Controls canonical URLs, sitemap.xml, emails and Stripe redirect URLs.
#   IP mode:     http://123.45.67.89
#   With domain: https://shop.example.com   (also update the first line of Caddyfile)
SITE_URL="http://localhost:3000"
STORE_NAME="SOFT ARMOR"
CONTACT_EMAIL="hello@example.com"
# Locale for number/date formatting and text direction (use "rtl" for Hebrew/Arabic).
LOCALE="en-US"
TEXT_DIRECTION="ltr"

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite file (relative to prisma/). Production: PostgreSQL.
# The Prisma provider is switched automatically from this URL (scripts/select-db-provider.mjs).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://store:password@localhost:5432/store?schema=public"
# Used by docker-compose.yml for the bundled PostgreSQL container (DATABASE_URL is built from these):
POSTGRES_USER="store"
POSTGRES_PASSWORD="change-me-to-a-long-random-password"
POSTGRES_DB="store"

# ── Money & tax ─────────────────────────────────────────────────────────────
# Default currency (ISO 4217, e.g. USD, EUR, ILS). Prices are stored in minor units (cents/agorot).
CURRENCY="USD"
# Tax/VAT rate as a fraction (0.17 = 17%, 0 = no tax).
TAX_RATE="0.17"
# true = catalog prices include tax (VAT, EU/IL style); false = tax added at checkout (US style).
PRICES_INCLUDE_TAX="true"
# Automatic price rule: retailPrice = supplierCost × PRICE_MARKUP (unless manually overridden per product).
PRICE_MARKUP="2.5"
# Variants with stock at or below this show up as "low stock" on the dashboard.
LOW_STOCK_THRESHOLD="5"
# (Currency, tax, markup, store name, contact email can later be changed in Admin → Settings.)

# ── Payments ────────────────────────────────────────────────────────────────
# "stripe" (default) or "mock" (offline test payments for local development only).
PAYMENT_PROVIDER="stripe"
# Stripe keys: https://dashboard.stripe.com/apikeys – sk_test_… for test mode, sk_live_… for live.
STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_…) for {SITE_URL}/api/webhooks/stripe – see README.
STRIPE_WEBHOOK_SECRET=""
# Mock payments are refused when NODE_ENV=production unless this is true. NEVER enable on a live store.
ALLOW_MOCK_PAYMENTS="false"

# ── Email ───────────────────────────────────────────────────────────────────
# "console" prints emails to the server log; "smtp" sends them via SMTP_* below.
MAIL_TRANSPORT="console"
MAIL_FROM="SOFT ARMOR <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ── Admin & security ────────────────────────────────────────────────────────
# Long random string used to sign admin sessions. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-run-openssl-rand-hex-32"
# First admin account – created automatically on first start/seed if no admin exists.
# Change the password in Admin → Settings after the first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-10-chars"

# ── File uploads ────────────────────────────────────────────────────────────
# "local" stores files in UPLOAD_DIR (a Docker volume). "s3" is a stub – see src/lib/storage/index.ts.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="8"

# ── Suppliers (dropshipping) ────────────────────────────────────────────────
# "csv" (works out of the box), "cj" (CJ Dropshipping stub) or "spocket" (stub) – see README.
SUPPLIER_ADAPTER="csv"
# Forward paid orders to the supplier API automatically (requires an implemented API adapter).
SUPPLIER_AUTO_PLACE="false"
CJ_API_KEY=""
CJ_API_EMAIL=""
SPOCKET_API_KEY=""

# ── Docker only ─────────────────────────────────────────────────────────────
# Seed placeholder products on container start (idempotent – skipped if they already exist).
SEED_ON_START="false"
